{
  "manifest_version": 3,
  "name": "Aurora – Nueva Pestaña",
  "version": "1.3.0",
  "description": "Nueva pestaña con accesos, pendientes, calendario, partidos y fondos personalizables.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "favicon"],
  "optional_permissions": ["tabs", "idle"],
  "host_permissions": ["https://calendar.google.com/*", "https://ics.fixtur.es/*"],
  "background": { "service_worker": "activity.js" }
}
